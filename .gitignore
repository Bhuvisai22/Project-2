cat > .gitignore << EOF
# Node.js
node_modules/
npm-debug.log
yarn-error.log
yarn-debug.log
.pnpm-debug.log
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build output
build/
dist/

# Docker
.dockerignore

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Misc
.DS_Store
Thumbs.db
EOF
